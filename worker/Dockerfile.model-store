# Build from the Vidia repo with --build-context model_release=<release directory>.
ARG WORKER_IMAGE
FROM ${WORKER_IMAGE} AS model-store
COPY worker/src/ /src/
COPY workflows/ /workflows/
COPY --from=model_release nodes/ /opt/model-release/nodes/
COPY --from=model_release manifest.json /opt/model-release/manifest.json
RUN config=/opt/model-release/nodes/comfyui-frame-interpolation/config.yaml \
    && if [ -f "$config" ]; then \
        sed -i 's|^ckpts_path:.*|ckpts_path: "/opt/model-cache/models/frame_interpolation"|' "$config" \
        && grep -qx 'ckpts_path: "/opt/model-cache/models/frame_interpolation"' "$config"; \
    fi
ENV DEPLOYMENT_MODE=serverless \
    MODEL_STORE_MANIFEST=/opt/model-release/manifest.json \
    MODEL_STORE_NODE_DIR=/opt/model-release/nodes \
    MODEL_STORE_ROOT=/opt/model-cache/models \
    AUX_ANNOTATOR_CKPTS_PATH=/opt/model-cache/models/annotator \
    WORKFLOWS_BASE=/
CMD ["/bin/bash", "/src/start.sh"]

# The Linux amd64 binary from denoland/deno:bin-2.9.6 supports yt-dlp's EJS.
FROM denoland/deno@sha256:456e1a0fada18d727c3f38eb4937218c1b46924c832b713dcf9358eb32ff15a6 AS deno

FROM model-store AS oshified
COPY --from=deno /deno /usr/local/bin/deno
COPY --from=model_release release-receipt.json /opt/model-release/release-receipt.json
RUN /usr/bin/python3 -m pip install --no-cache-dir \
        -r /opt/model-release/nodes/vidia-open-studio-node/requirements.txt \
    && /usr/bin/python3 -c "import yt_dlp_ejs" \
    && /usr/bin/python3 -m yt_dlp --version \
    && deno --version \
    && ffmpeg -version

FROM model-store AS vidia
